<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_bridge_nodes</name>
  <version>0.1.0</version>
  <description>Standalone ROS2 Go2 bridge nodes for OpenClaw-to-Go2 command routing.</description>
  <maintainer email="radxa@local.dev">radxa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>unitree_go</depend>
  <depend>unitree_api</depend>
  <depend>go2_bridge_msgs</depend>

  <exec_depend>python3</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
